[Unit]
Description=my-agent-team backend (control plane; spawns the Lark bot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/my-agent-team/apps/backend
# bun loads apps/backend/.env from the working directory; keeping secrets in
# one 0600 file beats duplicating them in a unit file.
EnvironmentFile=/root/my-agent-team/apps/backend/.env
Environment=NODE_ENV=production
# systemd does not set HOME for a unit that names no User=, and both `lark-cli`
# (profile discovery: ~/.lark-cli/config.json) and bun's own caches resolve it.
# Without this the bot answers "not configured" on every send while the same
# command works from a login shell (live 2026-11-19).
Environment=HOME=/root
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
# ADR 0068: the Lark bot runs as its own unit (my-agent-team-lark-bot@<agent>),
# started/stopped by the backend with systemctl. Unset would keep it a child of
# this process, which dies with it.
Environment=LARK_BOT_SUPERVISOR=systemd
ExecStart=/root/.bun/bin/bun run src/main.ts
Restart=always
RestartSec=3
# The Lark bot is a child of this process: take the whole group down together,
# otherwise a restart leaves a second bot connected to the same app.
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
