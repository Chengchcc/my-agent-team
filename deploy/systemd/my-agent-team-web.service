[Unit]
Description=my-agent-team web (Next.js surface on :3001)
After=network-online.target my-agent-team-backend.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/my-agent-team/apps/web
# Next loads apps/web/.env (BACKEND_URL, BACKEND_AUTH_TOKEN, SESSION_SECRET,
# MOCK_PASSWORD) from the working directory.
Environment=NODE_ENV=production
Environment=PATH=/root/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/root/.bun/bin/bun node_modules/next/dist/bin/next start --port 3001 -H 127.0.0.1
Restart=always
RestartSec=3
# Production build: `bun run scripts/rebuild-web.sh` (next build under a Node
# heap cap - this box is 2 cores / 8 GB, and a cgroup-uncapped build once ran
# 70 minutes at 0.9% CPU). The unit serves .next via `next start`; a source
# change is NOT picked up until that rebuild + restart. MemoryMax stays as the
# per-unit fast-fail cap: exceeding it kills THIS unit, not the backend.
MemoryMax=3400M
MemorySwapMax=0
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
