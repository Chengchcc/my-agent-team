{
  "name": "@chengchenccc/embedding",
  "version": "0.1.0",
  "private": true,
  "description": "Local embedding engine: fastembed ONNX provider, SQLite vector+FTS store, hybrid recall. Shared by oma's memory and (per ADR 0043) any other consumer that opts into the ONNX entry point.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./fastembed": {
      "types": "./src/fastembed.ts",
      "default": "./src/fastembed.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome check . && eslint .",
    "test": "bun test src --pass-with-no-tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "optionalDependencies": {
    "fastembed": "2.1.0",
    "onnxruntime-node": "1.21.0"
  },
  "devDependencies": {}
}
