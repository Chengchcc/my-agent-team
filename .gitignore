node_modules/
dist/
*.tsbuildinfo
.turbo/
.cache/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example
.backend-data/
apps/web/tsconfig.tsbuildinfo
.claude/skills
.agents

# oma workspace runtime data (memory, product-tools). The RSI harness
# surfaces (rules/skills/rsi) stay tracked — they are the evolved object.
.oma/*
!.oma/rules/
!.oma/skills/
!.oma/rsi/
# The build loop's work queue is the loop's memory and its trail: the agent
# commits it every iteration, so it must not be ignored like the rest of the
# local runtime state.
!.oma/plan.md

# The package dir is a workspace when the TUI is run from it (`bun run dev` in
# apps/oh-my-agent), so the same runtime data lands here: agent-status.json is
# rewritten by every such run (and by the TUI tests using cwd as the workspace).
# Not a fixture — nothing reads it — so it must not dirty the tree.
apps/oh-my-agent/.oma/

# omp backend project dir: not used here (oma is the harness for this repo).
# Ignored wholesale — the tracked project rules moved to .oma/rules/, which is
# where oma's stream-rule loader actually reads from.
.omp/

# Quality Playbook run artifacts
quality/

# Self-hosted monaco assets (generated by scripts/predev.sh)
apps/web/public/monaco/

# Stack artifact build output (scripts/pack-stack.sh)
dist-gateway/

# npm pack output
*.tgz
