node_modules/
dist/
*.tsbuildinfo
.turbo/
.cache/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example
.backend-data/
apps/web/tsconfig.tsbuildinfo
.claude/skills
.agents

# oma workspace runtime data (memory, product-tools). The RSI harness
# surfaces (rules/skills/rsi) stay tracked — they are the evolved object.
.oma/*
!.oma/rules/
!.oma/skills/
!.oma/rsi/

# omp backend project dir. Same rule as .oma: the shared surfaces (harness
# contract + project rules) stay tracked — omp's own tooling writes new
# rules into .omp/rules/*.md, so ignoring the whole dir would silently keep
# them out of the repo. Everything else there (config.yml, sessions, caches)
# is local state.
.omp/*
!.omp/SYSTEM.md
!.omp/rules/

# Quality Playbook run artifacts
quality/

# Self-hosted monaco assets (generated by scripts/predev.sh)
apps/web/public/monaco/

# Stack artifact build output (scripts/pack-stack.sh)
dist-gateway/

# npm pack output
*.tgz
