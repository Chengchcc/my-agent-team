#!/bin/sh
# Lint only the files THIS push changes. The pre-push contract hands the refs on
# stdin (<local ref> <local sha> <remote ref> <remote sha>), which names the
# pushed range exactly. Recomputing a base locally (@{push}) can be stale, and
# then the hook lints a whole branch's worth of files instead of this push's
# handful — minutes of eslint with no output, longer than the connection
# survives mid-push (observed: `Connection to github.com closed by remote host`
# right after the hook finished, while the same push with --no-verify landed in
# 9 seconds; 3 files lint in 20s, 61 files take minutes).
#
# Still not the full turbo lint: 15 packages routinely OOMs on this 3.5GB box
# under earlyoom.
#
# POSIX sh only — husky runs this with sh, where a bash array is a syntax error.
list_changed() {
  git diff --name-only --diff-filter=ACMR "$1" -- \
    '*.ts' '*.tsx' '*.js' '*.mjs' '*.css' '*.json' ':!bun.lock' 2>/dev/null
}

RANGES=""
if [ ! -t 0 ]; then
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    # A deleted ref has nothing to lint.
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    # A brand-new branch has no remote side: fall back to the upstream tip.
    if [ -z "$remote_sha" ] || [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
      remote_sha=$(git rev-parse --verify --quiet origin/master 2>/dev/null || true)
      [ -z "$remote_sha" ] && continue
    fi
    RANGES="$RANGES $remote_sha..$local_sha"
  done
fi

# Manual run (no hook stdin): fall back to the upstream.
if [ -z "$RANGES" ]; then
  BASE=$(git rev-parse --verify --quiet @{push} 2>/dev/null || git rev-parse --verify --quiet origin/master 2>/dev/null || true)
  if [ -z "$BASE" ]; then
    echo "pre-push: no base to diff against, skipping"
    exit 0
  fi
  RANGES=" $BASE..HEAD"
fi

CHANGED=""
for range in $RANGES; do
  CHANGED="$CHANGED
$(list_changed "$range")"
done
CHANGED=$(printf '%s\n' "$CHANGED" | sed '/^$/d' | sort -u)

if [ -z "$CHANGED" ]; then
  echo "pre-push: no changed lintable files, skipping"
  exit 0
fi
COUNT=$(printf '%s\n' "$CHANGED" | wc -l | tr -d ' ')
echo "pre-push: biome + eslint on $COUNT changed files"
bunx biome check $CHANGED || exit 1

# eslint runs AFTER the push connection is already open, so time spent here is
# time the remote sees as an idle session. On this box it needs 15+ minutes for
# five files (type-aware rules over the whole program, on a 3.5GB machine that
# is already swapping), and github.com closes the connection long before that —
# every push then hangs for ten minutes and fails. Bound it: biome above is the
# cheap gate, CI runs the full eslint on the pushed commit, and a timeout is
# announced rather than silent.
echo "pre-push: eslint on $COUNT changed files (CI runs the full set too)"
if command -v timeout >/dev/null 2>&1; then
  timeout 120 bunx eslint $CHANGED || echo "pre-push: eslint did not finish in 120s — leaving it to CI"
else
  bunx eslint $CHANGED
fi
